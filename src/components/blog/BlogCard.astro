---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, date, categories, description, image } = post.data;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const categoryLabels: Record<string, string> = {
  aviation: 'Aviation',
  trains: 'Trains',
  'ai-safety': 'AI Safety',
  climate: 'Climate',
  tech: 'Tech',
  personal: 'Personal',
};
---

<article
  class={`group relative bg-surface rounded-2xl overflow-hidden border border-border hover:border-accent transition-all duration-300 hover:shadow-lg ${
    featured ? 'md:col-span-2' : ''
  }`}
  data-categories={categories.join(',')}
>
  {image && (
    <div class={`overflow-hidden ${featured ? 'h-64' : 'h-44'}`}>
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6">
    <!-- Categories -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {categories.map((cat) => (
        <span class="text-[10px] font-bold uppercase tracking-widest text-accent px-2 py-0.5 rounded-full bg-accent/10">
          {categoryLabels[cat] ?? cat}
        </span>
      ))}
    </div>

    <h2 class={`font-display font-bold text-primary mb-2 leading-snug ${featured ? 'text-2xl' : 'text-lg'}`}>
      <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h2>

    <p class="text-sm text-muted line-clamp-2 mb-4">{description}</p>

    <p class="text-xs text-muted">{formatted}</p>
  </div>
</article>
