---
// Hero is always dark for dramatic impact, regardless of system theme.
---

<section
  id="top"
  class="relative min-h-screen bg-black flex flex-col items-center justify-center text-center px-6 overflow-hidden"
>
  <!-- Subtle grid background -->
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 64px 64px;"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto">
    <p class="text-[#98989d] text-sm font-medium tracking-[0.2em] uppercase mb-8 animate-[fadeIn_0.8s_ease_forwards]">
      Hello, I'm
    </p>

    <h1
      class="font-display font-extrabold text-white leading-none tracking-tight mb-6"
      style="font-size: clamp(3rem, 10vw, 9rem); animation: fadeUp 0.8s 0.2s ease both;"
    >
      Vanchhit<br />Sahal
    </h1>

    <p
      class="text-[#98989d] text-lg md:text-xl max-w-xl mx-auto leading-relaxed mb-12"
      style="animation: fadeUp 0.8s 0.4s ease both;"
    >
      AI safety · aviation · trains · climate ·
      the occasional game
    </p>

    <div
      class="flex flex-wrap items-center justify-center gap-4"
      style="animation: fadeUp 0.8s 0.6s ease both;"
    >
      <a
        href="/about"
        class="px-6 py-3 bg-white text-black font-semibold text-sm rounded-full hover:bg-[#f5f5f7] transition-colors"
      >
        About me
      </a>
      <a
        href="/blog"
        class="px-6 py-3 border border-white/30 text-white font-semibold text-sm rounded-full hover:border-white/60 transition-colors"
      >
        Read my writing
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2"
    style="animation: fadeIn 1.2s 1s ease both;"
    aria-hidden="true"
  >
    <div class="flex flex-col items-center gap-1.5 text-[#6e6e73]">
      <span class="text-xs tracking-widest uppercase">Scroll</span>
      <svg class="animate-bounce" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; }
  }
</style>
