---
// Google Maps embed for favourite places list
const mapsUrl = 'https://maps.app.goo.gl/BCKsFE2F6UmrvoH1A';
---

<div class="rounded-2xl overflow-hidden border border-border">
  <iframe
    src="https://www.google.com/maps/embed?pb=!1m0!3m2!1sen!2sde!4v1700000000000!5m2!1sen!2sde"
    title="Favourite places map"
    width="100%"
    height="450"
    style="border: 0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="w-full"
  ></iframe>
</div>
<p class="text-xs text-muted mt-3 text-center">
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hover:text-primary transition-colors underline underline-offset-2"
  >
    Open full map in Google Maps ↗
  </a>
</p>
