---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Currently from '../components/home/Currently.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const sections = [
  {
    href: '/blog',
    label: 'Blog',
    desc: 'Aviation, trains, AI safety, climate & more',
    emoji: '✍️',
    accent: '#333333',
  },
  {
    href: '/projects',
    label: 'Projects',
    desc: "Things I've built and researched",
    emoji: '🛠️',
    accent: '#0066cc',
  },
  {
    href: '/travel',
    label: 'Travel',
    desc: 'Countries lived in & favourite places',
    emoji: '🗺️',
    accent: '#0e5c8a',
  },
  {
    href: '/interests',
    label: 'Interests',
    desc: 'Aviation, trains, books, films and obsessions',
    emoji: '🔭',
    accent: '#7c3aed',
  },
  {
    href: '/games',
    label: 'Games',
    desc: 'Mini games to play in your browser',
    emoji: '🕹️',
    accent: '#9333ea',
  },
  {
    href: '/about',
    label: 'About',
    desc: "Who I am, where I've been, what I care about",
    emoji: '👤',
    accent: '#c45c26',
  },
];
---

<Base title="Home">
  <Nav />
  <Hero />

  <!-- Main content -->
  <div class="max-w-site mx-auto px-6">
    <!-- Currently -->
    <Currently />

    <!-- Section tiles -->
    <section class="py-16 border-b border-border">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-8">Explore</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sections.map(({ href, label, desc, emoji, accent }) => (
          <a
            href={href}
            class="group relative flex flex-col gap-3 p-6 rounded-2xl border border-border bg-surface hover:border-accent transition-all duration-300 hover:shadow-md"
          >
            <span class="text-2xl">{emoji}</span>
            <div>
              <h2 class="font-display font-bold text-primary text-lg mb-1 group-hover:text-accent transition-colors">
                {label}
              </h2>
              <p class="text-sm text-muted leading-snug">{desc}</p>
            </div>
            <span class="mt-auto text-sm text-accent font-medium">
              Explore →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Latest posts -->
    {latestPosts.length > 0 && (
      <section class="py-16 border-b border-border">
        <div class="flex items-center justify-between mb-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Latest writing</p>
          <a href="/blog" class="text-sm text-accent hover:opacity-75 transition-opacity font-medium">
            All posts →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {latestPosts.map((post) => (
            <div class="fade-up">
              <BlogCard post={post} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Now teaser -->
    <section class="py-16">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-8 rounded-2xl border border-border bg-surface">
        <div class="flex-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-2">Now</p>
          <p class="text-primary text-sm leading-relaxed">
            What I'm currently focused on — updated manually, not algorithmically.
          </p>
        </div>
        <a
          href="/now"
          class="shrink-0 px-5 py-2.5 rounded-full border border-accent text-accent text-sm font-semibold hover:bg-accent hover:text-bg transition-colors"
        >
          See now →
        </a>
      </div>
    </section>
  </div>

  <Footer />
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
</script>
