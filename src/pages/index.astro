---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Currently from '../components/home/Currently.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const topics = [
  { href: '/blog/aviation',  short: 'Aviation',  desc: 'Spotting, airports & aircraft',   color: 'oklch(0.60 0.17 230)' },
  { href: '/blog/trains',    short: 'Trains',    desc: 'Rail travel & rolling stock',      color: 'oklch(0.62 0.16 55)'  },
  { href: '/blog/ai-safety', short: 'AI Safety', desc: 'Alignment, governance & risk',     color: 'oklch(0.52 0.22 275)' },
  { href: '/blog/climate',   short: 'Climate',   desc: 'Energy & decarbonisation',         color: 'oklch(0.50 0.11 150)' },
  { href: '/blog',           short: 'General',   desc: 'Everything else',                  color: 'var(--accent)'        },
];
---

<Base title="Home">
  <Nav />
  <Hero />

  <!-- Topic strip -->
  <div class="border-y border-border bg-surface/50">
    <div class="max-w-site mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 divide-x divide-y lg:divide-y-0 divide-border overflow-hidden">
      {topics.map(({ href, short, desc, color }) => (
        <a
          href={href}
          class="group flex flex-col gap-1 bg-bg px-5 py-6 transition-colors hover:bg-surface"
        >
          <span class="font-mono text-[10px] uppercase tracking-widest text-muted">Topic</span>
          <span class="font-display text-base font-semibold tracking-tight" style={`color: ${color}`}>{short}</span>
          <span class="text-xs text-muted leading-snug">{desc}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Main content -->
  <div class="max-w-site mx-auto px-6">
    <!-- Currently -->
    <Currently />

    <!-- Latest posts -->
    {latestPosts.length > 0 && (
      <section class="py-16 border-b border-border">
        <div class="flex items-center justify-between mb-8">
          <p class="font-display text-2xl font-semibold tracking-tight text-primary">Latest writing</p>
          <a href="/blog" class="text-sm text-muted hover:text-primary transition-colors font-medium">
            All posts →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {latestPosts.map((post) => (
            <div class="fade-up">
              <BlogCard post={post} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Travel teaser -->
    <section class="py-16 border-b border-border">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-muted mb-3">Travel</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-primary mb-4">
            Countries, and counting.
          </h2>
          <p class="text-muted text-base leading-relaxed max-w-md mb-6">
            An interactive world map of where I've been, plus pins for spots I'd
            send a friend back to.
          </p>
          <a
            href="/travel"
            class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:gap-3 transition-all"
          >
            Open the map
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10 10 2M5 2h5v5"/>
            </svg>
          </a>
        </div>
        <div class="aspect-[4/3] rounded-2xl border border-border motif-blueprint"></div>
      </div>
    </section>

    <!-- Now teaser -->
    <section class="py-16">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-8 rounded-2xl border border-border bg-surface">
        <div class="flex-1">
          <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">Now</p>
          <p class="text-primary text-sm leading-relaxed">
            What I'm currently focused on — updated manually, not algorithmically.
          </p>
        </div>
        <a
          href="/now"
          class="shrink-0 px-5 py-2.5 rounded-full border border-accent text-accent text-sm font-semibold hover:bg-accent hover:text-bg transition-colors"
        >
          See now →
        </a>
      </div>
    </section>
  </div>

  <Footer />
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
</script>
