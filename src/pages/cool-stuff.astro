---
import Page from '../layouts/Page.astro';
import { coolStuff } from '../data/cool-stuff';

const grouped = coolStuff.reduce<Record<string, typeof coolStuff>>((acc, item) => {
  (acc[item.category] ??= []).push(item);
  return acc;
}, {});

const categoryOrder = ['Tools', 'Data', 'Reading'];
const sortedCategories = [
  ...categoryOrder.filter((c) => grouped[c]),
  ...Object.keys(grouped).filter((c) => !categoryOrder.includes(c)),
];
---

<Page title="Cool stuff" page="cool-stuff">
  <div class="pt-12">
    <p class="font-mono text-xs uppercase tracking-widest text-muted mb-3">More</p>
    <h1 class="font-display font-semibold text-5xl md:text-6xl tracking-tight text-primary mb-4">
      Cool stuff.
    </h1>
    <p class="text-muted text-lg mb-16 max-w-2xl">
      Links, tools, and things I keep coming back to. A loose collection that grows over time.
    </p>

    <div class="flex flex-col gap-14">
      {sortedCategories.map((category) => (
        <section>
          <h2
            class="font-display text-xl font-semibold tracking-tight mb-5"
            style="color: var(--accent)"
          >
            {category}
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {grouped[category].map((item) => {
              const Tag = item.url ? 'a' : 'div';
              const props = item.url
                ? { href: item.url, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <Tag
                  {...props}
                  class="group flex items-start justify-between gap-3 rounded-xl border border-border bg-card p-5 transition-all hover:border-accent fade-up"
                >
                  <div>
                    <p class="font-display font-semibold text-base tracking-tight text-primary mb-1">
                      {item.title}
                    </p>
                    {item.excerpt && (
                      <p class="text-sm text-muted leading-snug">{item.excerpt}</p>
                    )}
                  </div>
                  {item.url && (
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0 mt-0.5 text-muted"
                      aria-hidden="true"
                    >
                      <path d="M2 10 10 2M5 2h5v5" />
                    </svg>
                  )}
                </Tag>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Page>
