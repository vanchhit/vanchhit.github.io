---
import Page from '../layouts/Page.astro';
import WorldMap from '../components/maps/WorldMap.tsx';
import FavPlacesMap from '../components/maps/FavPlacesMap.astro';
import { livedInCountries } from '../data/lived-in-countries';
---

<Page title="Travel" page="travel">
  <div class="pt-12">
    <h1 class="font-display font-extrabold text-5xl md:text-6xl text-primary mb-4">Travel</h1>
    <p class="text-muted text-lg mb-3 max-w-xl">
      Places I've lived in, passed through, and loved.
    </p>
    <p class="text-sm text-muted mb-16">
      <span class="font-semibold text-accent">{livedInCountries.length} countries</span> called home.
    </p>

    <!-- Map 1: Countries lived in -->
    <section class="mb-20">
      <h2 class="font-display font-bold text-2xl text-primary mb-2">Countries I've lived in</h2>
      <p class="text-sm text-muted mb-6">Hover over a highlighted country to see a note.</p>

      <WorldMap client:load />

      <!-- Country list -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {livedInCountries.map(({ name, note }) => (
          <div class="p-4 rounded-xl border border-border bg-surface fade-up">
            <p class="font-semibold text-sm text-primary mb-1">{name}</p>
            <p class="text-xs text-muted leading-snug">{note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Map 2: Favourite places -->
    <section class="mb-8">
      <h2 class="font-display font-bold text-2xl text-primary mb-2">Favourite places</h2>
      <p class="text-sm text-muted mb-6">
        A curated list of spots I keep recommending to people.
      </p>
      <FavPlacesMap />
    </section>
  </div>
</Page>

<script>
  // Dark mode hint for WorldMap — re-render handled by React's theme awareness
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
</script>
